#!/bin/bash
# Blocks every push while the privacy check finds anything (R-002): tracked files, then the whole
# history of all refs including commit messages, author and committer.
root="$(git rev-parse --show-toplevel)"
"$root/scripts/datenschutz-check.sh" --all
files=$?
"$root/scripts/datenschutz-check.sh" --historie
history=$?
[ $files -eq 0 ] && [ $history -eq 0 ]
